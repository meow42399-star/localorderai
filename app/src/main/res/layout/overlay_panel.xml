<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_panel_bg"
    android:padding="14dp"
    android:elevation="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="حالة الحملة"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnPanelClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:padding="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOverlayCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="0 / 0"
        android:textColor="#CCCCCC"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvOverlayCurrent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="العميل: -"
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:layout_marginTop="2dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <!-- Mic / Speaker toggles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/btnToggleMic"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="🎤"
                android:textSize="20sp"
                android:background="@drawable/overlay_toggle_bg" />

            <TextView
                android:id="@+id/tvMicLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="تسجيل المكالمة"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/btnToggleSpeaker"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="🔊"
                android:textSize="20sp"
                android:background="@drawable/overlay_toggle_bg" />

            <TextView
                android:id="@+id/tvSpeakerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="السماعة"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp" />

    <!-- Max attempts -->
    <TextView
        android:id="@+id/tvOverlayAttemptsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="أقصى عدد محاولات: 5"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/btnAttemptsMinus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="－"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/overlay_toggle_bg" />

        <SeekBar
            android:id="@+id/seekOverlayAttempts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:max="100"
            android:progress="5" />

        <TextView
            android:id="@+id/btnAttemptsPlus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="＋"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/overlay_toggle_bg" />
    </LinearLayout>

    <!-- Delay seconds -->
    <TextView
        android:id="@+id/tvOverlayDelayLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="الفاصل بين المحاولات: 90 sec"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/btnDelayMinus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="－"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/overlay_toggle_bg" />

        <SeekBar
            android:id="@+id/seekOverlayDelay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:min="1"
            android:max="999"
            android:progress="90" />

        <TextView
            android:id="@+id/btnDelayPlus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="＋"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/overlay_toggle_bg" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOverlayStopCampaign"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="إيقاف الحملة"
        android:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF" />

</LinearLayout>
