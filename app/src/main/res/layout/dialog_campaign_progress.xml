<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvCampaignTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="حالة الحملة"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCampaignCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 / 0"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvCurrentClient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Client: -"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvAutoDialSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto Dial: غير مفعل"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvAutoDialDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="محاولات: 0 / 0 - الفاصل: 0 sec"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvAudioStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ميك: غير معروف - مكبر: غير معروف"
        android:layout_marginTop="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCampaignLogs"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStopCampaignFromDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="إيقاف الحملة" />

</LinearLayout>