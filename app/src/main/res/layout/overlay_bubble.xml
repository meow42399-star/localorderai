<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:minWidth="200dp"
    android:background="@drawable/overlay_panel_bg"
    android:padding="14dp"
    android:elevation="6dp">

    <!-- صف علوي: تسمية الحالة + عداد التقدم -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvBubbleBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="جاري الاتصال"
            android:textColor="#8AB4FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBubbleCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- اسم العميل الحالي - أكبر وأوضح -->
    <TextView
        android:id="@+id/tvBubbleName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:text="-"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- رقم الهاتف الحالي - أكبر وأوضح -->
    <TextView
        android:id="@+id/tvBubblePhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="end"
        android:text="-"
        android:textColor="#CCCCCC"
        android:textSize="15sp"
        android:textDirection="ltr"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- محاولة رقم كام من كام -->
    <TextView
        android:id="@+id/tvBubbleAttempt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:text="محاولة: - / -"
        android:textColor="#8AB4FF"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <!-- أزرار سريعة: كتم المايك / السماعة / إيقاف الحملة -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/btnBubbleMic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_mic"
                android:background="@drawable/overlay_toggle_bg" />

            <TextView
                android:id="@+id/tvBubbleMicLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="المايك"
                android:textColor="#AAAAAA"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/btnBubbleSpeaker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_speaker"
                android:background="@drawable/overlay_toggle_bg" />

            <TextView
                android:id="@+id/tvBubbleSpeakerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="سماعة"
                android:textColor="#AAAAAA"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/btnBubbleMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⋯"
                android:textSize="20sp"
                android:background="@drawable/overlay_toggle_bg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="المزيد"
                android:textColor="#AAAAAA"
                android:textSize="9sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
